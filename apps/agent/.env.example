# LiveKit Cloud project. https://cloud.livekit.io
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Sarvam AI: speech-to-text, text-to-speech and (by default) live answers
SARVAM_API_KEY=

# Live answers: "sarvam" (default) or "anthropic"
LLM_PROVIDER=sarvam
# Optional model override. Sarvam default: sarvam-105b-conversations. Anthropic default: claude-opus-5-5
LLM_MODEL=
# Only needed when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# true = stream all mic audio to STT (lower latency, pays for silence)
# false (default) = send only detected speech (cheaper)
STT_STREAMING=false

# Play lessons whose text is not native-reviewed yet (testing only)
ALLOW_DRAFT_LESSONS=false

# Daily AI (Sarvam) spend cap in rupees. New sessions are refused and running ones end politely
# once today's estimated spend reaches it. 0 = no cap. Keep web and agent the same.
DAILY_SPEND_CAP_INR=50

# Phone notifications (ntfy.sh, free): session costs, 80% and cap-reached alerts. Use a long random topic. Empty = off.
NTFY_TOPIC=
