# Same LiveKit project as the agent worker. Copy to .env.local.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Owner cost dashboard at /admin (at least 8 characters)
ADMIN_PASSWORD=
# Sarvam free credit and optional monthly budget for the dashboard meters (INR)
SARVAM_CREDIT_INR=100
MONTHLY_BUDGET_INR=500

# --- Sign-in and payments ---
# Test account for development: never gets an SMS, always accepts TEST_ACCOUNT_OTP. Ignored in production.
TEST_ACCOUNT_PHONE=9000000001
TEST_ACCOUNT_OTP=123456
COURSE_PRICE_INR=99
FREE_TRIAL_MINUTES=10
# Razorpay keys (use test-mode keys while testing). Empty = built-in test payment button (development only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# List lessons whose text is not native-reviewed yet (testing only)
ALLOW_DRAFT_LESSONS=false

# Sarvam: used to prepare lessons from admin files
SARVAM_API_KEY=

# Daily AI (Sarvam) spend cap in rupees. New sessions are refused and running ones end politely
# once today's estimated spend reaches it. 0 = no cap. Keep web and agent the same.
DAILY_SPEND_CAP_INR=50

# Lesson assistant: YouTube video search (free key, no billing: console.cloud.google.com > enable "YouTube Data API v3" > Credentials > API key)
YOUTUBE_API_KEY=
