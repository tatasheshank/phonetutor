# HTTPS in front of the web app. Caddy gets and renews a free Let's Encrypt certificate
# for $DOMAIN automatically (ports 80 and 443 must be open to the internet).
# HTTPS is required: browsers only allow the microphone on secure pages.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "microphone=(self), camera=()"
	}
}
