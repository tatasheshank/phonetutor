# Tutor worker settings for the server. Copy to deploy/agent.env and fill in.
# deploy/agent.env is never copied into images or committed.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

SARVAM_API_KEY=

# Live answers: "sarvam" (default) or "anthropic"
LLM_PROVIDER=sarvam
LLM_MODEL=
ANTHROPIC_API_KEY=

# false = send only detected speech to speech-to-text (cheaper)
STT_STREAMING=false

# Play lessons whose text is not native-reviewed yet (staging only)
ALLOW_DRAFT_LESSONS=true

# Daily AI (Sarvam) spend cap in rupees. New sessions are refused and running ones end politely
# once today's estimated spend reaches it. 0 = no cap. Keep web and agent the same.
DAILY_SPEND_CAP_INR=50

# Phone notifications (ntfy.sh, free): session costs, 80% and cap-reached alerts. Use a long random topic. Empty = off.
NTFY_TOPIC=
