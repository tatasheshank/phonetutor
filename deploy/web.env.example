# Web app settings for the server. Copy to deploy/web.env and fill in.
# deploy/web.env is never copied into images or committed.

# Same LiveKit project as the agent
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Owner dashboard at https://<your domain>/admin. Use a NEW long password here, not your laptop's.
ADMIN_PASSWORD=
SARVAM_CREDIT_INR=100
MONTHLY_BUDGET_INR=500

# Course
COURSE_PRICE_INR=99
FREE_TRIAL_MINUTES=10

# Razorpay (test-mode keys while testing). Empty = test payment button (only with ALLOW_TEST_FEATURES).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# STAGING ONLY. true = test account + OTPs printed in `docker compose logs web` + test payment button.
# Set to false (and set up SMS + Razorpay) before any real learner uses this site.
ALLOW_TEST_FEATURES=true
TEST_ACCOUNT_PHONE=9000000001
TEST_ACCOUNT_OTP=123456
